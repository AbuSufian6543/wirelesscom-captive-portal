# Include this file inside the existing server that answers for the public IP.
# It does not declare server_name and does not listen on 80 or 443 by itself.
# Other websites on that server are left unchanged.

location /guest/ {
    proxy_pass http://${PORTAL_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_redirect off;
}

