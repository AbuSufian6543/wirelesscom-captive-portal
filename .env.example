# Copy to .env and replace every secret before the first boot.
# Never commit .env. The public IP below is temporary deployment configuration.

APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=3000
# Address Docker publishes on the application server. Use a private LAN address
# when the NGINX reverse proxy is a different machine. Never 80 or 443.
APP_BIND_HOST=0.0.0.0
APP_TRUST_PROXY=true

# Temporary public address UniFi is pointed at today. Change this when the IP changes.
PORTAL_PUBLIC_IP=64.141.110.164
# Hostname terminated by the separate NGINX server. Leave empty until DNS exists.
PORTAL_DOMAIN=
# Redirect HTTP to HTTPS only for PORTAL_DOMAIN. IP access stays on HTTP.
PORTAL_FORCE_HTTPS=false
# Public base URL used in password-reset links. Example: https://captive.example.com
APP_PUBLIC_URL=

DATABASE_URL=postgresql://portal:portal@db:5432/portal?schema=public
# openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string
# openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

INITIAL_ADMIN_EMAIL=abu@wirelesscom.ca
INITIAL_ADMIN_PASSWORD=Master@12345678

# Optional bootstrap hints for a real controller. Per-tenant controllers are stored
# in the database and can be changed from the admin panel.
UNIFI_API_URL=
UNIFI_API_USERNAME=
UNIFI_API_PASSWORD=
UNIFI_API_STYLE=UNIFI_OS

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=STARTTLS
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="WirelessCom Captive Portal"

MESSAGE_API_URL=
MESSAGE_API_KEY=
MESSAGE_API_SECRET=
MESSAGE_SENDER_ID=

# Set to true only when Redis is started (docker compose --profile redis).
REDIS_URL=
